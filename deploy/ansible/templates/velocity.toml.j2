{% if "config-version" not in source.native.velocity_keys %}
config-version = "2.7"
{% endif %}
bind = {{ (instance.address ~ ':' ~ instance.port) | to_json }}
{% if "motd" not in source.native.velocity_keys %}
motd = "Minecraft"
{% endif %}
{% if "show-max-players" not in source.native.velocity_keys %}
show-max-players = 20
{% endif %}
online-mode = true
player-info-forwarding-mode = "modern"
forwarding-secret-file = "forwarding.secret"

{{ source.native.velocity }}

[servers]
{% for name, address in enderpin_backends.items() | sort %}
{{ name | to_json }} = {{ address | to_json }}
{% endfor %}
try = {{ enderpin_try | to_json }}

[forced-hosts]
