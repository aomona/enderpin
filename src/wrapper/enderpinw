#!/bin/sh
# Generated by Enderpin. Commit this file and enderpin-wrapper.properties.
set -eu
fail() { printf 'enderpinw: %s\n' "$*" >&2; exit 1; }
root=$(CDPATH= cd -P -- "$(dirname -- "$0")" && pwd)
properties=$root/enderpin-wrapper.properties
[ -f "$properties" ] || fail "missing $properties"
property() {
    awk -F= -v key="$1" '$1 == key { value = substr($0, length(key) + 2); count++ }
        END { if (count != 1) exit 1; print value }' "$properties" || fail "missing or duplicate property: $1"
}
version=$(property version)
case "$version" in ''|*[!0-9A-Za-z.+-]*|[!0-9]*) fail 'invalid pinned version';; esac
case "$(uname -s)" in
    Darwin) os=darwin; default_cache=${HOME:?}/Library/Caches;;
    Linux) os=linux; default_cache=${XDG_CACHE_HOME:-${HOME:?}/.cache};;
    *) fail 'supported systems: macOS and Linux; use enderpinw.ps1 on Windows';;
esac
case "$(uname -m)" in
    arm64|aarch64) cpu=arm64;;
    x86_64|amd64) cpu=x64;;
    *) fail 'supported CPUs: x64 and ARM64';;
esac
platform=$os-$cpu
archive_hash=$(property "archive.$platform.sha256")
binary_hash=$(property "binary.$platform.sha256")
for digest in "$archive_hash" "$binary_hash"; do
    [ "${#digest}" = 64 ] || fail 'invalid SHA-256'
    case "$digest" in *[!0-9a-f]*) fail 'invalid SHA-256';; esac
done
sha256() {
    if command -v sha256sum >/dev/null 2>&1; then result=$(sha256sum "$1") || fail 'could not hash file';
    elif command -v shasum >/dev/null 2>&1; then result=$(shasum -a 256 "$1") || fail 'could not hash file';
    else fail 'install sha256sum or shasum'; fi
    printf '%s\n' "${result%% *}"
}
cache=${ENDERPIN_WRAPPER_CACHE:-$default_cache/enderpin/wrapper}
directory=$cache/$version/$platform/$binary_hash
binary=$directory/enderpin
[ ! -L "$binary" ] || fail "cache entry is a symbolic link: $binary"
if [ -e "$binary" ]; then
    [ -f "$binary" ] && [ "$(sha256 "$binary")" = "$binary_hash" ] || fail "corrupt cache entry; remove $directory and retry"
else
    umask 077
    mkdir -p "$directory"
    temporary=$(mktemp -d "$directory/.download.XXXXXXXX")
    trap 'rm -rf "$temporary"' EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'exit 129' HUP
    url=https://github.com/aomona/enderpin/releases/download/v$version/enderpin-$platform.tgz
    printf 'enderpinw: downloading Enderpin %s (%s)\n' "$version" "$platform" >&2
    curl --fail --location --silent --show-error --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 300 "$url" --output "$temporary/archive.tgz"
    [ "$(sha256 "$temporary/archive.tgz")" = "$archive_hash" ] || fail 'archive SHA-256 mismatch'
    # Extract only the executable to a file we chose, never archive-supplied paths.
    tar -xOzf "$temporary/archive.tgz" package/bin/enderpin > "$temporary/enderpin"
    [ "$(sha256 "$temporary/enderpin")" = "$binary_hash" ] || fail 'binary SHA-256 mismatch'
    chmod 700 "$temporary/enderpin"
    mv -f "$temporary/enderpin" "$binary"
    rm -rf "$temporary"
    trap - EXIT INT TERM HUP
fi
exec "$binary" "$@"
