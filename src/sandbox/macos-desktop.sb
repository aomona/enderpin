; Java/LWJGL desktop service names also used by MonaLauncher. No blanket Mach or home access.
(allow mach-lookup
    (global-name "com.apple.windowserver.active") (global-name "com.apple.CARenderServer")
    (global-name "com.apple.cvmsServ") (global-name "com.apple.coreservices.launchservicesd")
    (global-name "com.apple.lsd.mapdb") (global-name "com.apple.FontObjectsServer")
    (global-name "com.apple.fonts") (global-name "com.apple.system.notification_center")
    (global-name "com.apple.bsd.dirhelper") (global-name "com.apple.windowmanager.server")
    (global-name "com.apple.audio.audiohald") (global-name "com.apple.audio.AudioComponentRegistrar")
    (global-name "com.apple.tsm.uiserver") (global-name "com.apple.dock.fullscreen")
    (xpc-service-name "com.apple.MTLCompilerService")
    (xpc-service-name "com.apple.hiservices-xpcservice")
    (xpc-service-name "com.apple.ViewBridgeAuxiliary")
    (xpc-service-name "com.apple.TextInputUI.xpc.CursorUIViewService"))
(allow iokit-open (iokit-user-client-class "AGXDeviceUserClient")
    (iokit-user-client-class "IOGPUGLDrawableUserClient") (iokit-user-client-class "IOGPUSurfaceMTL")
    (iokit-user-client-class "IOSurfaceRootUserClient"))
(allow ipc-posix-shm-read* ipc-posix-shm-write-data (ipc-posix-name-regex #"^AudioIO"))
(allow mach-register (local-name "com.apple.tsm.portname"))
(allow user-preference-read (preference-domain "com.apple.HIToolbox") (preference-domain "com.apple.hitoolbox"))
(allow file-read* (subpath "/usr/share/icu") (subpath "/usr/share/locale")
    (literal "/Library/Preferences/com.apple.HIToolbox.plist"))
