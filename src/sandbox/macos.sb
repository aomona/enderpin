(version 1)
(deny default)
(allow process-exec (subpath (param "JAVA")))
(allow process-info* signal (target same-sandbox))
(allow sysctl-read file-read-metadata)
(allow file-read* (literal "/") (subpath "/System/Library")
    (subpath "/System/Cryptexes") (subpath "/usr/lib")
    (subpath "/private/var/db/timezone"))
(allow file-read* file-write* (subpath (param "GAME")) (subpath (param "TMP"))
    (literal "/dev/null"))
(allow file-read* (literal "/dev/random") (literal "/dev/urandom"))
(allow mach-lookup (global-name "com.apple.system.logger") (global-name "com.apple.logd"))
